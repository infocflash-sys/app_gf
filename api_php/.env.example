# Copiar a .env y completar. Nunca subir .env al repositorio.

# MariaDB del ERP (idealmente un usuario con permiso SOLO SELECT)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=intran23_mis_envios
RUTEO_DB=intran23_ruteo

# FTP con las imágenes y los PDF del ERP (idealmente cuenta limitada y de solo lectura)
FTP_HOST=ftp.intranetflash.com
FTP_USER=
FTP_PASS=
FTP_ROOT=/archivoscompartidos.intranetflash.com/public
FTP_POOL=3

# Secreto para firmar sesiones (largo y aleatorio, distinto al de api/ Node)
JWT_SECRET=
ACCESS_TTL=1800
REFRESH_TTL=34560000

CACHE_DIR=../cache
PIEZAS_DIAS=30

{
    "name": "grupo-flash/portal-api-php",
    "description": "API de solo lectura del Portal Clientes Grupo Flash (puerto PHP, en paralelo al api/ Node)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-ftp": "*",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "test/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

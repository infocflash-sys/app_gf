# Copiar a .env y completar. Nunca subir .env al repositorio.
PORT=3000
HOST=0.0.0.0

# MariaDB del ERP (idealmente un usuario con permiso SOLO SELECT)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=intran23_mis_envios

# FTP con las imágenes y los PDF (idealmente cuenta limitada y de solo lectura)
FTP_HOST=ftp.intranetflash.com
FTP_USER=
FTP_PASS=
FTP_ROOT=/archivoscompartidos.intranetflash.com/public
FTP_POOL=3

# Secreto para firmar sesiones (largo y aleatorio)
JWT_SECRET=
ACCESS_TTL=30m
REFRESH_TTL=400d

CACHE_DIR=./cache
PIEZAS_DIAS=30
